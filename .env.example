# ローカル開発用の設定例。`.env` にコピーして使う(.env はコミットしない)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tripdiary
MYSQL_USER=tripdiary
MYSQL_PASSWORD=tripdiary

# バックエンド(NestJS / Prisma)用。backend/.env にコピーして使う
DATABASE_URL=mysql://tripdiary:tripdiary@localhost:3306/tripdiary
# アクセストークン(JWT)の署名鍵。十分に長いランダム文字列にする
# 例: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# 写真の置き場(S3)。ローカルでは、docker compose の s3(S3Mock)を使う(docker compose up -d s3)。
# AWS では、S3_BUCKET と S3_REGION だけを指定する(S3_ENDPOINT は付けない。認証はタスクロール)
S3_BUCKET=tripdiary-local
S3_REGION=ap-northeast-1
S3_ENDPOINT=http://localhost:9090
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
